# =====================================================================
# TUNTAS Backend — Environment Variables
# Copy to `.env`, fill required values, and never commit `.env`.
# Keep comments on separate lines so Docker/hosting env parsers stay safe.
# =====================================================================

# ---------------------------------------------------------------------
# App — required, not secret
# ---------------------------------------------------------------------
APP_ENV=development
APP_NAME=TUNTAS
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8001

# ---------------------------------------------------------------------
# Supabase — required
# Dashboard -> Project Settings -> API Keys
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend-only full-access key. Never expose it to frontend or WorkBuddy.
SUPABASE_SECRET_KEY=

# Usually: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Required for LangGraph durable checkpoints and atomic Postgres RPCs.
# Dashboard -> Connect -> Session pooler -> URI.
# Prefer the Session pooler on port 5432 for long-lived psycopg connections.
# Always include ?sslmode=require (backend also normalizes if missing).
# Example shape:
# postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Buckets will be created by the setup migration/script.
SUPABASE_ARTIFACTS_BUCKET=tuntas-artifacts
SUPABASE_POLICY_BUCKET=tuntas-policy-sources

# ---------------------------------------------------------------------
# Gemini — required
# One API key is shared by generation and embeddings.
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# Requested low-cost model for routine agent work.
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Stable fallback for critical policy/challenger steps if the preview model
# is unavailable or fails schema validation.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Verified live with output_dimensionality=768 for pgvector HNSW.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------
# Live vendor research — strongly recommended for the judged demo
# Get a free key from https://app.tavily.com/
# Without a key, hybrid mode uses versioned source snapshots/fixtures.
# ---------------------------------------------------------------------
TAVILY_API_KEY=
VENDOR_RESEARCH_MODE=hybrid
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=10
VENDOR_EVIDENCE_MAX_AGE_DAYS=30

# ---------------------------------------------------------------------
# Application security — required, generate locally (not external APIs)
# APP_MASTER_ENCRYPTION_KEY:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# ARTIFACT_HMAC_KEY and MCP_SERVICE_TOKEN:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate a different value for each variable.
# ---------------------------------------------------------------------
APP_MASTER_ENCRYPTION_KEY=
ARTIFACT_HMAC_KEY=
MCP_SERVICE_TOKEN=

# MCP gateway calls only explicitly whitelisted backend operations.
MCP_BACKEND_BASE_URL=http://localhost:8001
MCP_HOST=0.0.0.0
MCP_PORT=8787
MCP_PATH=/mcp

# Development only: allow X-Demo-Role / X-Demo-Actor headers without JWT.
DEMO_AUTH_BYPASS=true

# ---------------------------------------------------------------------
# Durable workflow — required, not secret
# ---------------------------------------------------------------------
LANGGRAPH_CHECKPOINT_SCHEMA=tuntas_checkpoint
WORKFLOW_MAX_CONCURRENCY=3
WORKFLOW_STEP_TIMEOUT_SECONDS=180
WORKFLOW_MAX_RETRIES=2

# ---------------------------------------------------------------------
# Input/source configuration — required, not secret
# ---------------------------------------------------------------------
AMBANK_TRIGGER_SCHEMA_VERSION=v1
ALLOW_SYNTHETIC_TRIGGER_FALLBACK=true
POLICY_SOURCE_DIR=./data/policies
VENDOR_FIXTURE_PATH=./data/fixtures/vendors.json
ARTIFACT_TEMP_DIR=./var/artifacts

# ---------------------------------------------------------------------
# Case Study 4 defaults — not secret; request payloads may override them
# ---------------------------------------------------------------------
DEFAULT_EMPLOYEE_COUNT=250
MAX_COST_PER_EMPLOYEE_MYR=5000
TOTAL_BUDGET_MYR=1250000
TRAINING_WINDOW_START=2026-07-01
TRAINING_WINDOW_END=2026-09-30
MIN_OPERATIONAL_COVERAGE_RATIO=0.70

# ---------------------------------------------------------------------
# Optional: write approved schedules directly to Google Calendar.
# Leave blank for the default ICS export, which needs no API key.
# ---------------------------------------------------------------------
CALENDAR_PROVIDER=ics
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8001/v1/integrations/google/callback

# ---------------------------------------------------------------------
# Optional future Tencent Cloud migration — not needed for the prototype.
# Leave blank until sponsorship/resources are available.
# ---------------------------------------------------------------------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-singapore
